# Example environment variables for local development
# Copy this to .env.local (Next.js) or set as OS env variables

# Preferred: a full DATABASE_URL
# Examples:
#   postgres://user:password@localhost:5432/euge_trading
#   postgresql://localhost:5432/euge_trading
DATABASE_URL=

# OR set individual DB parts (used when DATABASE_URL is empty)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=euge_trading
DB_USER=
DB_PASSWORD=

# Next.js runtime API base (optional)
# For client-side calls to custom domains, set NEXT_PUBLIC_API_BASE
NEXT_PUBLIC_API_BASE=

# Other env variables you may set
SITE_NAME=EUGE Trading Academy
CONTACT_EMAIL=contact@example.com# Database Configuration
# Option 1: Use connection string (recommended)
DATABASE_URL=postgresql://username:password@localhost:5432/euge_trading

# Option 2: Use individual parameters
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=euge_trading
# DB_USER=postgres
# DB_PASSWORD=your_password

# Application Settings (optional)
NODE_ENV=development
